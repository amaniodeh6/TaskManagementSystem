@model TaskItem

<div class="col-md-6 mx-auto mt-4">

    <h2 class="text-center mb-4">Delete Task</h2>

    <div class="card shadow-sm p-4">
        <h5 class="text-danger text-center mb-4">Are you sure you want to delete this task?</h5>

        <dl class="row">
            <dt class="col-sm-4">Title:</dt>
            <dd class="col-sm-8">@Model.Title</dd>
            <dt class="col-sm-4">Description:</dt>
            <dd class="col-sm-8">@Model.Description</dd>
            <dt class="col-sm-4">Due Date:</dt>
            <dd class="col-sm-8">@Model.DueDate</dd>
            <dt class="col-sm-4">Priority:</dt>
            <dd class="col-sm-8">@Model.Priority</dd>
            <dt class="col-sm-4">Status:</dt>
            <dd class="col-sm-8">@Model.Status</dd>
        </dl>

<form asp-action="Delete" method="post">
            <div class="d-flex justify-content-center gap-3 mt-3">
                <input type= "hidden" asp-for="Id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger px-4">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>
